# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# mock JSON data store (MOCK_DB_PATH) — local fixtures, regenerated on first run
/data

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template README.md tells you to copy. Without this negation the
# example file can never be committed, so a fresh clone has nothing to copy.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
