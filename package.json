{
  "name": "javelin-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:authz": "node --import ./scripts/register-ts.mjs scripts/verify-authz.mts",
    "verify:pages": "node --import ./scripts/register-ts.mjs scripts/verify-pages.mts",
    "verify:supabase": "node --import ./scripts/register-ts.mjs scripts/verify-supabase.mts",
    "check:demo-data": "node --import ./scripts/register-ts.mjs scripts/check-demo-data.mts",
    "db:link": "supabase link --project-ref trocsdetpwyqcgyfclir",
    "db:push": "supabase db push",
    "verify:visual": "playwright test",
    "test:unit": "node --import ./scripts/register-ts.mjs --test \"tests/unit/*.test.mts\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
