# JavelinHub — local POC environment
#
# Copy to `.env.local` before running `npm run dev`.
# Nothing here is a real credential. The Supabase values are placeholders:
# the app runs on whichever DATA_BACKEND selects; the Supabase values are read
# only when it is "supabase". Every value is referenced through src/lib/env.ts
# so that swapping DATA_BACKEND is a config change and never a code change.

# Which data layer implementation to use: "mock" (default) | "supabase"
DATA_BACKEND=mock

# Where the mock JSON store lives, relative to the project root.
MOCK_DB_PATH=./data/db.json

# Secret used to sign the local mock session cookie.
# Generate your own for local use, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-random-32-byte-hex-string

# Seeded admin account for the POC. The mock store is seeded from these on
# first run; they are local development values, never committed real secrets.
SEED_ADMIN_EMAIL=admin@javelin.test
SEED_ADMIN_PASSWORD=replace-me-local-admin-password

# This app's own public origin, no trailing slash. Used to build the absolute
# link in a password-reset email, and deliberately NOT derived from the request:
# the Host header is attacker-controlled, and a reset link built from it is a
# valid link to a real account pointing at somebody else's domain.
#
# Leave it unset locally and it falls back to http://localhost:3000. In
# production set it to the real domain, and add the same origin to the Supabase
# dashboard's Authentication -> URL Configuration -> Redirect URLs, or GoTrue
# refuses the redirect.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Supabase
#
# Needed only when DATA_BACKEND=supabase. Both NEXT_PUBLIC_* values come from
# the project's API settings; both are safe to expose to the browser, which is
# the whole premise of the RLS model in supabase/migrations/0002_rls.sql.
#
# Before flipping DATA_BACKEND, apply the schema:
#   supabase link --project-ref <ref>
#   supabase db push
# then seed and bootstrap an admin as supabase/README.md describes.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ONE file in src/ reads this, and only one ever should:
# src/lib/auth/account-deletion.ts, which bans the GoTrue user when somebody
# deletes their account. Nothing else can do it -- delete_my_account() cannot
# reach the auth schema, so the credential would otherwise outlive the deletion.
#
# THAT FILE BUILDS NO SUPABASE CLIENT. It makes one fetch to one GoTrue admin
# endpoint. The danger this key carries is BYPASSRLS -- a client built from it
# ignores every policy in 0002_rls.sql silently -- and never constructing one is
# what keeps the key out of the data path entirely. Adding a createClient() call
# there is the change that makes the warning apply again.
#
# Leave it blank and account deletion still anonymises the profile and closes the
# app; what does not happen is the credential dying, and the code reports that
# rather than pretending otherwise.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Transactional email (Resend)
#
# TWO SEPARATE JOBS, and only the second one is this application's code:
#
#   1. GoTrue's own mail — password reset, signup confirmation, email change.
#      That rides on Supabase's built-in SMTP, which is capped at a handful of
#      messages an hour project-wide and is not for production. Moving it to
#      Resend is CONFIGURATION IN THE SUPABASE DASHBOARD and no code at all:
#      Project Settings -> Authentication -> SMTP Settings. Nothing below
#      affects it.
#
#   2. The app's own notifications — "you have a new order", "your file is
#      ready". Those are src/lib/email/, and these two variables.
#
# Leave RESEND_API_KEY unset and sendEmail() logs the message and skips, which
# is the supported local and CI state: no account needed, and no risk of a
# development run emailing a real person.
#
# EMAIL_FROM must be on a domain VERIFIED IN RESEND, or messages are rejected
# or land in spam. Its default is a reserved .invalid address on purpose, so an
# unset sender can never be somebody else's real mailbox — and the boot check
# in src/lib/env.ts refuses to start a production server that has a key set and
# this still at its default.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
